<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Pos?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="RatingsAndFeedbackPageController" stylesheets="app.css">
    <children>
        <!-- Header -->
        <Label text="Ratings and Feedback" style="-fx-font-size: 24;" layoutX="150" layoutY="20"/>
        
        <!-- Rating Section -->
        <Label text="Rate the Service:" layoutX="50" layoutY="80" style="-fx-font-size: 16;"/>
        <Slider fx:id="ratingSlider" min="1" max="5" value="3" layoutX="50" layoutY="110" showTickLabels="true" showTickMarks="true" majorTickUnit="1" minorTickCount="0"/>
        <Label fx:id="ratingLabel" text="3" layoutX="300" layoutY="110" style="-fx-font-size: 16;"/>

        <!-- Feedback Section -->
        <Label text="Your Feedback:" layoutX="50" layoutY="160" style="-fx-font-size: 16;"/>
        <TextArea fx:id="feedbackTextArea" layoutX="50" layoutY="190" prefHeight="150" prefWidth="400"/>

        <!-- Submit and Back Buttons -->
        <HBox spacing="10" alignment="CENTER" layoutX="50" layoutY="380">
            <Button text="Submit" fx:id="submitButton" onAction="#handleSubmit"/>
            <Button text="Back" fx:id="backButton" onAction="#handleBack"/>
        </HBox>
    </children>
</AnchorPane>
