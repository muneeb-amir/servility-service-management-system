<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="ViewRequestsController" spacing="10" alignment="TOP_CENTER">
    <Label text="Your Service Requests" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
    
    <TableView fx:id="requestsTable" prefHeight="400" prefWidth="600">
        <columns>
            <TableColumn fx:id="seekerNameColumn" text="Seeker Name" prefWidth="100" />
            <TableColumn fx:id="expertiseColumn" text="Expertise" prefWidth="100" />
            <TableColumn fx:id="budgetColumn" text="Budget" prefWidth="100" />
            <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="150" />
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="100" />
            <TableColumn fx:id="providerNameColumn" text="Provider Name" prefWidth="100" />
        </columns>
    </TableView>

    <Button fx:id="backButton" text="Back to Dashboard" onAction="#handleBack" />
</VBox>